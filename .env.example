# HighlightHub configuration template. Copy to .env and adjust.
# NEVER commit real secrets.

# ---- database ----
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=highlight_hub
DB_USER=highlight
DB_PASSWORD=change-me-db

# ---- service auth ----
# Shared token between backend and media-worker (internal /internal/** API).
WORKER_TOKEN=change-me-worker-token

# ---- ports ----
BACKEND_PORT=8080
FRONTEND_PORT=80
WORKER_HEALTH_PORT=8123

# ---- security ----
# Set true behind HTTPS in production so the session cookie gains Secure.
COOKIE_SECURE=false

# ---- conservative default quotas (bytes) ----
UPLOAD_MAX_FILE_BYTES=2147483648
DEFAULT_USER_QUOTA_BYTES=2147483648
RENDER_MAX_OUTPUT_BYTES=2147483648
